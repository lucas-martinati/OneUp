{
  "rules": {
    ".read": "auth != null && auth.token.admin === true",
    ".write": "auth != null && auth.token.admin === true",
    "users": {
      ".indexOn": ["settings/timezone"],
      "$uid": {
        // Lecture admin (panneau d'administration) ou propriétaire du compte.
        ".read": "$uid === auth.uid || auth.token.admin === true",
        "progress": {
          // PRIVÉ : seul le propriétaire lit son progress. Les fonctionnalités
          // sociales lisent les stats publiques dérivées dans `publicProfiles`
          // (sans le calendrier ni les traces GPS). Auparavant ce nœud était
          // lisible par tout utilisateur authentifié — ce qui exposait les
          // traces GPS cardio ; c'est désormais fermé.
          ".read": "$uid === auth.uid || auth.token.admin === true",
          ".write": "$uid === auth.uid || auth.token.admin === true",
          "streakFreezes": {
            // Écriture réservée à l'admin (et à la Cloud Function via le SDK
            // Admin, non soumise à ces règles).
            ".write": "auth.token.admin === true",
            // Gel de série : count borné à [0, 6] (max Pro) et lastRefill au
            // format 'YYYY-MM' (7 caractères). Empêche un utilisateur de
            // s'attribuer un nombre arbitraire de gels via l'API.
            ".validate": "newData.val() === null || (newData.hasChildren(['count', 'lastRefill']) && newData.child('count').isNumber() && newData.child('count').val() >= 0 && newData.child('count').val() <= 6 && newData.child('lastRefill').isString() && newData.child('lastRefill').val().length === 7)"
          },
          "frozenDays": {
            // Écriture réservée à l'admin (la Cloud Function écrit les jours
            // gelés via le SDK Admin) ; suppression (null) autorisée aussi.
            ".write": "auth.token.admin === true",
            // Jours gelés : chaque clé doit être une date YYYY-MM-DD (10 chars)
            // et chaque valeur doit être le booléen true.
            "$date": {
              ".validate": "newData.val() === null || (newData.val() === true && $date.length === 10)"
            }
          }
        },
        "$topic": {
          // Le propriétaire écrit tout sauf `purchase` (pas d'auto-Pro) ;
          // l'admin (panneau d'administration) écrit n'importe quel topic.
          ".write": "($uid === auth.uid && $topic !== 'purchase') || auth.token.admin === true"
        }
      }
    },
    "leaderboard": {
      ".read": "auth != null",
      "$uid": {
        // Réinitialisation des totaux par l'admin (panneau d'administration).
        ".write": "auth.token.admin === true"
      }
    },
    "publicProfiles": {
      // Stats publiques dérivées (par exercice + streaks), calculées et écrites
      // EXCLUSIVEMENT par la Cloud Function recomputeLeaderboardEntry. Lecture
      // pour tout utilisateur authentifié, écriture client interdite. Permet la
      // fiche détail sociale sans lire le `progress` privé d'autrui.
      ".read": "auth != null",
      "$uid": {
        ".write": false
      }
    },
    "clans": {
      ".read": "auth != null",
      ".indexOn": ["code"],
      "$clanId": {
        ".write": "auth != null && ((!data.exists() && newData.child('createdBy').val() === auth.uid) || (!newData.exists() && !data.child('members').exists()))",
        "members": {
          "$memberUid": {
            ".write": "auth != null && $memberUid === auth.uid"
          }
        }
      }
    },
    "clanCodes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.exists()) || (!newData.exists() && (!root.child('clans').child(data.val()).exists() || !root.child('clans').child(data.val()).child('members').exists() || root.child('clans').child(data.val()).child('members').child(auth.uid).exists())))"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        "$senderUid": {
          // Pokes are aggregated per sender: the node is keyed by the sender's
          // uid. A sender may create OR update (increment) only their own node
          // and must stamp fromUid as themselves; the recipient may do anything
          // to their own notifications (e.g. delete on dismiss).
          // The sender also needs read on their own node so the increment
          // transaction can see the current count.
          ".read": "auth != null && ($senderUid === auth.uid || $uid === auth.uid)",
          ".write": "auth != null && (($senderUid === auth.uid && (!newData.exists() || newData.child('fromUid').val() === auth.uid)) || $uid === auth.uid)"
        }
      }
    }
  }
}
